# Deployment — set at BUILD time
# DEPLOYMENT_ENV=node  # node (default) | vercel | netlify | cloudflare

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
POSTGRES_NAME=postgres
POSTGRES_USER=postgres
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_NAME}

# Auth - Generate this secret by running `pnpm run auth:secret`
BETTER_AUTH_SECRET=change-me-to-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Zero sync
ZERO_UPSTREAM_DB=$DATABASE_URL
ZERO_QUERY_URL=http://localhost:3000/api/zero/query
ZERO_MUTATE_URL=http://localhost:3000/api/zero/mutate

# Trusted origins (comma-delimited, optional)
# TRUSTED_ORIGINS=https://example.com,https://other.com

# Site
SITE_NAME="My App"
